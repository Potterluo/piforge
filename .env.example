# PiForge isolated deployment — the values that actually work.
#
#   pwsh scripts/up-isolated.ps1
#
# That script builds these three images in the right order and passes them to
# docker compose, so this file is for the manual path (`docker compose -f
# docker-compose.runner.yml up`). It is also the honest answer to "which images
# do I need": the sandbox image must be piforge/sandbox-agent, built FROM the
# control plane image, because the published AIO base has no /opt/piforge and no
# `pi` — a sandbox running it cannot start the agent.
#
#   docker build -t piforge:isolated .
#   docker build -f deploy/Dockerfile.runner -t piforge/sandbox-runner:isolated .
#   docker build -f deploy/Dockerfile.sandbox-agent \
#     --build-arg AGENT_IMAGE=piforge:isolated -t piforge/sandbox-agent:isolated .
#
# `go run ./backend/cmd/preflight` checks all three, including what is inside the
# sandbox image, and fails naming what is missing.
#
# Copy this file to `.env`, then change the token. `.env` is not committed.

# Long random string. Both services read it; the runner rejects anything else.
SANDBOX_RUNNER_TOKEN=piforge-isolated-change-me

PIFORGE_IMAGE=piforge:isolated
PIFORGE_RUNNER_IMAGE=piforge/sandbox-runner:isolated
PIFORGE_SANDBOX_IMAGE=piforge/sandbox-agent:isolated

# The public port: 7723 by default so it cannot collide with a pf-local on 7722.
PIFORGE_PUBLISH=7723

# Named so `-Down` can find it; empty uses piforge-data.
PIFORGE_DATA_VOLUME=pf-isolated-data

# Which provider a session uses when it pins no model.
PIFORGE_DEFAULT_PROVIDER=volc
# name|base_url|model, plus the key. The key is sealed into the database on the
# first boot and never logged; leave both empty to configure it in Settings.
# The base URL below is a placeholder: use your provider's base URL.
# PIFORGE_BOOTSTRAP_PROVIDER=volc|https://api.example.com/v1|deepseek-v4-flash
# PIFORGE_BOOTSTRAP_PROVIDER_KEY=

# Egress policy: what a sandbox may reach beyond the control plane. The default
# (deploy/tenant-egress.json, mode none) creates each tenant's bridge --internal:
# no route to the public internet, while /gw/llm and the checkout still work
# because the control plane and the runner are on that bridge. Point the mount at
# another file for per-tenant overrides; `allowlist` is refused at startup.
# PIFORGE_TENANT_EGRESS_MOUNT=./deploy/tenant-egress.json
# PIFORGE_TENANT_EGRESS_MODE=open
